# Email Service (when you add Resend or SendGrid)
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL_TO=hello@shannonmuruli.com

# Analytics — traffic/behavior (self-hosted Umami)
NEXT_PUBLIC_UMAMI_SRC=https://your-umami-instance.example.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id

# Analytics — performance/errors (CloudWatch RUM)
NEXT_PUBLIC_RUM_APP_MONITOR_ID=your-rum-application-id
NEXT_PUBLIC_RUM_IDENTITY_POOL_ID=us-east-1:your-cognito-identity-pool-id
NEXT_PUBLIC_RUM_REGION=us-east-1

# Error Tracking (when you add Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Rate Limiting (when you add Upstash Redis)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
